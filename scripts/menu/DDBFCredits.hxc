import funkin.modding.module.Module;
import funkin.ui.credits.CreditsState;
import funkin.ui.credits.CreditsDataHandler;
import funkin.modding.ModStore;

class DDBFCredits extends Module
{
  public function new()
  {
    super('DDBFCredits', 1, {
      state: CreditsState
    });

    active = false;
    if (ModStore.get('DDBFAddedCreditsData') ?? false) return;
    ModStore.stores.set('DDBFAddedCreditsData', true);

    CreditsDataHandler.CREDITS_DATA.entries.unshift( // for example this one is on the bottom
      {
        header: "---------------------------------------",
        body: [
          {
            line: "",
          }
        ]
      });
    CreditsDataHandler.CREDITS_DATA.entries.unshift({
